---
import Layout from '@layouts/Layout.astro';
import Hero from '@components/Hero.astro';
import MeetTheTeam from '@components/MeetTheTeam.astro';
import { Icon } from 'astro-icon/components';
import LinkButton from '@components/LinkButton.astro';

const services = [
    {
        icon: 'mdi:monitor-cellphone',
        title: 'Custom Website Design',
        description: 'A professional, mobile-friendly website shaped around your business, your customers, and your goals.',
        href: '/web-development',
        linkText: 'View website packages'
    },
    {
        icon: 'mdi:magnify',
        title: 'Local SEO Foundations',
        description: 'Clean structure, thoughtful content, and technical essentials that help search engines understand your business.',
        href: '/web-development',
        linkText: 'See what is included'
    },
    {
        icon: 'mdi:shield-check-outline',
        title: 'Website Care Plans',
        description: 'Ongoing updates, maintenance, monitoring, and support so your website stays current after launch.',
        href: '/care-plans',
        linkText: 'Explore care plans'
    },
    {
        icon: 'mdi:palette-outline',
        title: 'Brand & Graphic Design',
        description: 'Consistent visual design for logos, business cards, flyers, signs, brochures, and digital marketing materials.',
        href: '/contact',
        linkText: 'Discuss a design project'
    }
];

const reasons = [
    {
        icon: 'mdi:account-tie-outline',
        title: 'Built around your business',
        description: 'No one-size-fits-all template. Your website is planned around what your customers need to see and do.'
    },
    {
        icon: 'mdi:cellphone-check',
        title: 'Fast and mobile-friendly',
        description: 'Every site is designed to look polished and work smoothly across phones, tablets, and desktops.'
    },
    {
        icon: 'mdi:map-marker-radius-outline',
        title: 'Local and approachable',
        description: 'You work with a Terre Haute team you can reach, we are not an anonymous platform or faraway support queue.'
    }
];

const steps = [
    {
        number: '01',
        title: 'Discover',
        description: 'We learn about your business, audience, goals, and what your new website needs to accomplish.'
    },
    {
        number: '02',
        title: 'Design & Build',
        description: 'We shape the content, design the experience, and develop a fast, responsive website.'
    },
    {
        number: '03',
        title: 'Launch & Grow',
        description: 'After review and launch, we can continue supporting the site as your business evolves.'
    }
];
---

<Layout
    title="Terre Haute Web Design & Marketing"
    description="Monarch Media LLC provides custom web design, website development, branding, and digital marketing for businesses in Terre Haute, Indiana and throughout the Wabash Valley."
    image="/images/ogbanner.png"
    imageAlt="Monarch Media LLC web design, branding, and digital marketing services"
>
    <Hero />

    <section
        id="what-we-do"
        aria-labelledby="services-heading"
        class="relative z-10 scroll-mt-20 border-y border-white/5 bg-black/15 px-4 py-20 md:px-6 md:py-28"
    >
        <div class="mx-auto max-w-7xl">
            <div class="max-w-3xl">
                <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-purple-300">More than a good-looking website</p>
                <h2 id="services-heading" class="font-header text-4xl font-bold tracking-tight text-white md:text-5xl">
                    A stronger digital presence starts here.
                </h2>
                <p class="mt-5 max-w-2xl text-lg leading-relaxed text-gray-300">
                    From your first website to ongoing support and branded materials, Monarch Media helps your business show up consistently and professionally.
                </p>
            </div>

            <div class="mt-12 grid gap-5 md:grid-cols-2">
                {
                    services.map((service) => (
                        <article class="group rounded-2xl border border-white/10 bg-white/[0.035] p-7 transition duration-300 hover:-translate-y-1 hover:border-primary/60 hover:bg-white/[0.055]">
                            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/30 text-purple-200">
                                <Icon name={service.icon} class="h-7 w-7" aria-hidden="true" />
                            </div>
                            <h3 class="mt-6 font-header text-2xl font-bold text-white">{service.title}</h3>
                            <p class="mt-3 leading-relaxed text-gray-300">{service.description}</p>
                            <LinkButton href={service.href} text={service.linkText} />
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <section aria-labelledby="why-heading" class="relative z-10 px-4 py-20 md:px-6 md:py-28">
        <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
            <div class="lg:sticky lg:top-28">
                <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-purple-300">Why Monarch Media</p>
                <h2 id="why-heading" class="font-header text-4xl font-bold tracking-tight text-white md:text-5xl">
                    Professional work with a personal connection.
                </h2>
                <p class="mt-5 text-lg leading-relaxed text-gray-300">
                    We combine design, development, and local market awareness to create websites that feel credible from the first click.
                </p>
                <a href="/portfolio" class="mt-7 inline-flex items-center gap-2 font-semibold text-purple-300 transition hover:text-white">
                    See our work
                    <Icon name="mdi:arrow-right" class="h-5 w-5" aria-hidden="true" />
                </a>
            </div>

            <div class="space-y-4">
                {
                    reasons.map((reason) => (
                        <article class="flex gap-5 rounded-2xl border border-white/10 bg-white/[0.03] p-6 md:p-7">
                            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-primary/50 bg-primary/20 text-purple-200">
                                <Icon name={reason.icon} class="h-6 w-6" aria-hidden="true" />
                            </div>
                            <div>
                                <h3 class="font-header text-xl font-bold text-white md:text-2xl">{reason.title}</h3>
                                <p class="mt-2 leading-relaxed text-gray-300">{reason.description}</p>
                            </div>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <section aria-labelledby="process-heading" class="relative z-10 border-y border-white/5 bg-black/15 px-4 py-20 md:px-6 md:py-28">
        <div class="mx-auto max-w-7xl">
            <div class="mx-auto max-w-2xl text-center">
                <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-purple-300">A clear path to launch</p>
                <h2 id="process-heading" class="font-header text-4xl font-bold tracking-tight text-white md:text-5xl">
                    From first conversation to finished website.
                </h2>
            </div>

            <ol class="mt-12 grid gap-5 lg:grid-cols-3">
                {
                    steps.map((step) => (
                        <li class="relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.035] p-7">
                            <span class="absolute right-5 top-2 font-header text-6xl font-bold text-white/[0.035]" aria-hidden="true">
                                {step.number}
                            </span>
                            <p class="text-sm font-bold tracking-[0.2em] text-purple-300">STEP {step.number}</p>
                            <h3 class="mt-5 font-header text-2xl font-bold text-white">{step.title}</h3>
                            <p class="mt-3 leading-relaxed text-gray-300">{step.description}</p>
                        </li>
                    ))
                }
            </ol>
        </div>
    </section>

    <div class="relative z-10">
        <MeetTheTeam />
    </div>

    <section class="relative z-10 px-4 pb-20 md:px-6 md:pb-28">
        <div
            class="mx-auto max-w-7xl overflow-hidden rounded-3xl border border-primary/40
                bg-gradient-to-br from-primary/45 via-[#24132f] to-[#111116] px-6 py-12
                text-center shadow-2xl md:px-12 md:py-16"
        >
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-purple-200">Ready when you are</p>
            <h2 class="mx-auto mt-4 max-w-3xl font-header text-4xl font-bold text-white md:text-5xl">Let's build a website your business is proud to share.</h2>
            <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-gray-200">
                Tell us where your business is today and where you want it to go. We'll help you find the right next step.
            </p>
            <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row">
                <a
                    href="/contact"
                    class="inline-flex items-center justify-center gap-2 rounded-lg
                        bg-white px-6 py-4 text-lg font-bold text-[#24132f] transition
                        hover:bg-gray-200 border-2 hover:text-complementary"
                >
                    Start a Conversation
                </a>
                <a
                    href="/web-development"
                    class="inline-flex items-center justify-center rounded-lg border
                    border-white/25 px-6 py-4 text-lg font-semibold text-white transition hover:bg-white/10"
                >
                    Compare Website Packages
                </a>
            </div>
        </div>
    </section>
</Layout>
