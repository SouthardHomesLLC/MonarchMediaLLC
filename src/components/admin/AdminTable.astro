---
import type { Admin } from '@data/AdminData';

interface Props {
    admins: Admin[];
}

const { admins } = Astro.props;

const formatDate = (value: string) =>
    new Intl.DateTimeFormat('en-US', {
        dateStyle: 'medium',
        timeStyle: 'short'
    }).format(new Date(value));
---

<section class="overflow-hidden rounded-2xl border border-white/10 bg-white/[0.04] shadow-xl shadow-black/10">
    <div class="border-b border-white/10 px-5 py-5 sm:px-6">
        <h2 class="text-xl font-semibold text-white">Administrators</h2>
        <p class="mt-1 text-sm text-white/60">
            {admins.length}{' '}
            {admins.length === 1 ? 'account' : 'accounts'}
        </p>
    </div>

    {
        admins.length === 0 ? (
            <div class="px-6 py-12 text-center">
                <p class="text-white/65">No administrator accounts were found.</p>
            </div>
        ) : (
            <div class="divide-y divide-white/10">
                {admins.map((admin) => (
                    <details class="group">
                        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-5 transition hover:bg-white/[0.03] sm:px-6">
                            <div class="min-w-0">
                                <div class="flex flex-wrap items-center gap-3">
                                    <h3 class="truncate font-semibold text-white">{admin.username}</h3>
                                    <span
                                        class:list={[
                                            'rounded-full border px-2.5 py-1 text-xs font-medium',
                                            admin.isActive
                                                ? 'border-emerald-400/30 bg-emerald-400/10 text-emerald-200'
                                                : 'border-white/15 bg-white/5 text-white/55'
                                        ]}
                                    >
                                        {admin.isActive ? 'Active' : 'Inactive'}
                                    </span>
                                </div>
                                <p class="mt-1 text-sm text-white/45">Created {formatDate(admin.createdAtUtc)}</p>
                            </div>

                            <span class="shrink-0 text-sm font-medium text-purple-300">
                                <span class="group-open:hidden">Edit</span>
                                <span class="hidden group-open:inline">Close</span>
                            </span>
                        </summary>

                        <div class="border-t border-white/10 bg-black/10 px-5 py-5 sm:px-6">
                            <form method="POST" class="space-y-5">
                                <input type="hidden" name="intent" value="update" />
                                <input type="hidden" name="id" value={admin.id} />

                                <div class="grid gap-5 md:grid-cols-2">
                                    <label class="block">
                                        <span class="mb-2 block text-sm font-medium text-white/80">Username</span>
                                        <input
                                            type="text"
                                            name="username"
                                            value={admin.username}
                                            minlength="3"
                                            maxlength="100"
                                            autocomplete="username"
                                            required
                                            class="w-full rounded-xl border border-white/15 bg-black/20 px-4 py-3 text-white outline-none transition focus:border-purple-400 focus:ring-2 focus:ring-purple-400/20"
                                        />
                                    </label>

                                    <label class="block">
                                        <span class="mb-2 block text-sm font-medium text-white/80">New password</span>
                                        <input
                                            type="password"
                                            name="newPassword"
                                            minlength="12"
                                            autocomplete="new-password"
                                            class="w-full rounded-xl border border-white/15 bg-black/20 px-4 py-3 text-white outline-none transition placeholder:text-white/30 focus:border-purple-400 focus:ring-2 focus:ring-purple-400/20"
                                            placeholder="Leave blank to keep current password"
                                        />
                                    </label>
                                </div>

                                <label class="flex w-fit cursor-pointer items-center gap-3">
                                    <input
                                        type="checkbox"
                                        name="isActive"
                                        checked={admin.isActive}
                                        class="size-4 rounded border-white/20 bg-black/20 text-purple-500 focus:ring-purple-400/30"
                                    />
                                    <span class="text-sm text-white/75">Account is active</span>
                                </label>

                                <div class="flex flex-wrap items-center justify-between gap-4">
                                    <button
                                        type="submit"
                                        class="rounded-xl bg-purple-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-purple-500 focus:outline-none focus:ring-2 focus:ring-purple-300 focus:ring-offset-2 focus:ring-offset-slate-950"
                                    >
                                        Save changes
                                    </button>
                                </div>
                            </form>

                            <form method="POST" class="mt-5 border-t border-white/10 pt-5" data-delete-form data-username={admin.username}>
                                <input type="hidden" name="intent" value="delete" />
                                <input type="hidden" name="id" value={admin.id} />

                                <button
                                    type="submit"
                                    class="rounded-xl border border-red-400/30 bg-red-500/10 px-5 py-3 text-sm font-semibold text-red-100 transition hover:bg-red-500/20 focus:outline-none focus:ring-2 focus:ring-red-300/50"
                                >
                                    Delete administrator
                                </button>
                            </form>
                        </div>
                    </details>
                ))}
            </div>
        )
    }
</section>

<script>
    document.querySelectorAll<HTMLFormElement>('[data-delete-form]').forEach((form) => {
        form.addEventListener('submit', (event) => {
            const username = form.dataset.username ?? 'this administrator';
            const confirmed = window.confirm(`Delete ${username}? This action cannot be undone.`);

            if (!confirmed) {
                event.preventDefault();
            }
        });
    });
</script>
