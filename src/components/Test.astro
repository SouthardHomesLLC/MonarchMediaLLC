---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { socialLinks } from '@data/SocialData';
import logo from '@assets/MonarchPurple.png';
---

<section class="relative mx-auto flex min-h-[82svh] max-w-7xl items-center overflow-hidden px-4 py-20 md:px-6 md:py-28">
    <div
        id="purpleblob"
        aria-hidden="true"
        class="pointer-events-none absolute left-1/3 top-1/2 z-0 h-[32rem] w-[32rem]
            -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary
            opacity-35 blur-[90px]"
    >
    </div>

    <div class="relative z-10 grid w-full items-center gap-14 lg:grid-cols-[1.2fr_0.8fr]">
        <div class="max-w-3xl">
            <p class="mb-5 font-body text-sm font-semibold uppercase tracking-[0.2em] text-[#d9bd69]">
                Terre Haute, Indiana · Serving the Wabash Valley
            </p>

            <h1 class="font-header text-5xl font-bold leading-[1.05] tracking-tight text-white sm:text-6xl lg:text-7xl">
                Websites built to help
                <span class="bg-gradient-to-r from-[#d7b95e] via-[#f0dda0] to-[#a46db8] bg-clip-text text-transparent">local businesses grow.</span>
            </h1>

            <p class="mt-7 max-w-2xl font-body text-lg leading-relaxed text-gray-300 md:text-xl">
                Monarch Media creates polished, high-performing websites that make your business easier to find, easier to trust, and easier to choose.
            </p>

            <div class="mt-9 flex flex-col gap-4 sm:flex-row">
                <a href="/contact" class="btn btn-lg rounded-lg shadow-lg shadow-primary/20">
                    Start Your Website
                    <Icon name="mdi:arrow-right" class="h-5 w-5" aria-hidden="true" />
                </a>

                <a
                    href="/web-development"
                    class="inline-flex items-center justify-center rounded-lg border border-white/20 px-6 py-[1.125rem]
                        text-lg font-semibold text-white transition hover:border-primary/70 hover:bg-white/5"
                >
                    Explore Website Packages
                </a>
            </div>

            <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-gray-400">
                <span class="inline-flex items-center gap-2">
                    <Icon name="mdi:check-circle-outline" class="h-5 w-5 text-[#d9bd69]" aria-hidden="true" />
                    Custom design
                </span>
                <span class="inline-flex items-center gap-2">
                    <Icon name="mdi:check-circle-outline" class="h-5 w-5 text-[#d9bd69]" aria-hidden="true" />
                    Mobile optimized
                </span>
                <span class="inline-flex items-center gap-2">
                    <Icon name="mdi:check-circle-outline" class="h-5 w-5 text-[#d9bd69]" aria-hidden="true" />
                    Search-ready foundation
                </span>
            </div>
        </div>

        <div class="relative mx-auto flex w-full max-w-md flex-col items-center">
            <div class="absolute inset-0 rounded-full bg-primary/25 blur-3xl" aria-hidden="true"></div>
            <div class="relative w-full rounded-3xl border border-white/10 bg-white/[0.045] p-8 shadow-2xl backdrop-blur-sm">
                <Image src={logo} alt="Monarch Media LLC" class="mx-auto w-44 drop-shadow-2xl" loading="eager" />

                <div class="mt-7 grid grid-cols-3 gap-2 border-t border-white/10 pt-6 text-center">
                    <div>
                        <Icon name="mdi:palette-outline" class="mx-auto h-6 w-6 text-[#d9bd69]" aria-hidden="true" />
                        <p class="mt-2 text-xs font-semibold uppercase tracking-wider text-gray-300">Design</p>
                    </div>
                    <div>
                        <Icon name="mdi:code-tags" class="mx-auto h-6 w-6 text-[#d9bd69]" aria-hidden="true" />
                        <p class="mt-2 text-xs font-semibold uppercase tracking-wider text-gray-300">Develop</p>
                    </div>
                    <div>
                        <Icon name="mdi:chart-line" class="mx-auto h-6 w-6 text-[#d9bd69]" aria-hidden="true" />
                        <p class="mt-2 text-xs font-semibold uppercase tracking-wider text-gray-300">Grow</p>
                    </div>
                </div>
            </div>

            <div class="relative z-10 mt-6 flex items-center gap-5">
                {
                    socialLinks.map((link) => {
                        const isExternal = link.href.startsWith('http');

                        return (
                            <a
                                href={link.href}
                                aria-label={link.label}
                                title={link.title}
                                target={isExternal ? '_blank' : undefined}
                                rel={isExternal ? 'noopener noreferrer' : undefined}
                                class="flex h-10 w-10 items-center justify-center rounded-full border border-white/10
                                    bg-white/[0.025] text-gray-400 transition-all duration-200
                                    hover:-translate-y-1 hover:border-primary/60 hover:bg-primary/15 hover:text-white"
                            >
                                <Icon name={link.icon} class="h-5 w-5" aria-hidden="true" />
                            </a>
                        );
                    })
                }
            </div>
        </div>
    </div>
</section>
